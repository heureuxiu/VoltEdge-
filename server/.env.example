NODE_ENV=development
PORT=4000

# Local MongoDB for development. Replace with your Atlas connection string later:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voltedge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/voltedge

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Browser origins allowed by CORS (comma separated): storefront first, then admin panel
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin account created by `npm run seed` (change the password before going live)
ADMIN_EMAIL=admin@voltedge.co.za
ADMIN_PASSWORD=voltedge123
ADMIN_NAME=VoltEdge Admin

# Only if you see `queryTxt ETIMEOUT` / `querySrv` errors (network blocks Atlas DNS lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1
